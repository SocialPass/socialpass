# Local development environment variables for Netlify CLI
# This file should not be committed to version control

# Django settings
DJANGO_SETTINGS_MODULE=config.settings.netlify
DEBUG=True
SECRET_KEY=local-development-secret-key-change-in-production

# Database settings - use SQLite for local development
DATABASE_URL=sqlite:///db.sqlite3

# Netlify specific settings
NETLIFY_DEV=true 