# MINIMAL Railway Environment Variables for SocialPass Demo
# Copy ONLY these variables to your Railway project for basic demo

# === REQUIRED CORE VARIABLES ===
DJANGO_SETTINGS_MODULE=config.settings.railway
DJANGO_SECRET_KEY=demo-secret-key-change-in-production-12345
DJANGO_DEBUG=False

# === DATABASE (REQUIRED) ===
DATABASE_URL=${{ Postgres.DATABASE_URL }}

# === BASIC DEMO SETUP COMPLETE ===
# The platform will work with just these 4 variables!
# 
# DEMO FEATURES ENABLED:
# ✅ Full signup/signin with email + password (no email verification required)
# ✅ Create and manage events
# ✅ Free ticket sales and distribution
# ✅ QR code ticket generation and scanning
# ✅ Google Wallet tickets
# ✅ Admin dashboard and team management
#
# OPTIONAL: Add these later for full functionality:
# - AWS S3 for file uploads (otherwise files stored locally, not persistent)
# - Stripe for payment processing (otherwise only free tickets work)
# - Google OAuth for social login (otherwise only email/password)
# - Email service for notifications (otherwise no emails sent)
# - ACCOUNT_EMAIL_VERIFICATION=mandatory (for production email verification)
